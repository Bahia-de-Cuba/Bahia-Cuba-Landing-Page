{
  "name": "bahia-de-cuba-landing",
  "version": "2.0.0",
  "private": true,
  "description": "Landing page del Hotel Bahía de Cuba — Playa Tuquillo, Huarmey (Áncash, Perú)",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o styles.css --minify",
    "build:icons": "node tools/build-icons.mjs",
    "build:img": "python3 tools/optimize-images.py",
    "build": "npm run build:icons && npm run build:css",
    "dev": "tailwindcss -i src/input.css -o styles.css --watch",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.39.0",
    "playwright": "^1.62.1",
    "simple-icons": "^15.16.0",
    "tailwindcss": "^4.3.3"
  }
}
