{
  "name": "bahia-de-cuba-landing",
  "version": "2.0.0",
  "private": true,
  "description": "Landing page del Hotel Bahía de Cuba — Playa Tuquillo, Huarmey (Áncash, Perú)",
  "scripts": {
    "build": "npm run build:icons && npm run build:js && npm run build:css && npm run build:html",
    "build:icons": "node tools/build-icons.mjs",
    "build:html": "node tools/build-html.mjs",
    "build:js": "node tools/build-js.mjs",
    "build:css": "tailwindcss -i src/css/input.css -o assets/css/styles.css --minify",
    "build:img": "python tools/optimize-images.py",
    "dev": "tailwindcss -i src/css/input.css -o assets/css/styles.css --watch",
    "check": "node tools/check.mjs",
    "preview": "python tools/build-preview.py",
    "serve": "python -m http.server 8080"
  },
  "devDependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.39.0",
    "playwright": "^1.62.1",
    "simple-icons": "^15.16.0",
    "tailwindcss": "^4.3.3"
  }
}
